# Drop this in /etc/nginx/sites-available/zracko.conf on the host,
# then: ln -s /etc/nginx/sites-available/zracko.conf /etc/nginx/sites-enabled/
# and: nginx -t && systemctl reload nginx
#
# Run certbot afterwards to add TLS:
#   certbot --nginx -d your-domain.com

upstream zracko_app {
    server 127.0.0.1:3000;
}

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com;

    location / {
        proxy_pass http://zracko_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
